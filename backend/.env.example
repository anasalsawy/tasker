DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# For local auth-bypass testing, use: sqlite:///./tasker-local.db
DB_CONNECTION_STRING=

JWT_ISS=TaskerBackend
JWT_SECRET=
REDIS_CONNECTION=

# Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-west-2

# Azure/OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Request limits. These prevent silent provider hangs.
TASKER_LLM_TIMEOUT=120
TASKER_LLM_MAX_RETRIES=2
TASKER_BEDROCK_CONNECT_TIMEOUT=300
TASKER_BEDROCK_READ_TIMEOUT=300
TASKER_BEDROCK_MAX_RETRIES=5

CLASSIFIER_AGENT_MODEL_TYPE=openai
CLASSIFIER_AGENT_MODEL_ID=gpt-4.1

TITLE_AGENT_MODEL_TYPE=openai
TITLE_AGENT_MODEL_ID=gpt-4.1-nano

SUGGESTOR_AGENT_MODEL_TYPE=openai
SUGGESTOR_AGENT_MODEL_ID=gpt-4.1-mini

PLANNER_AGENT_MODEL_TYPE=openai
PLANNER_AGENT_MODEL_ID=gpt-4.1

# Supported types: openai, azure_openai, anthropic, bedrock,
# openai_compatible, nvidia, gemini_compatible.
# For NVIDIA or a Gemini OpenAI-compatible gateway:
COMPUTER_USE_AGENT_MODEL_TYPE=openai_compatible
COMPUTER_USE_AGENT_MODEL_ID=your-model-id
COMPUTER_USE_AGENT_BASE_URL=
COMPUTER_USE_AGENT_API_KEY=

# Optional screenshot logging
ENABLE_SCREENSHOT_LOGGING_FOR_TRAINING=false
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_DESKTOP_REDIRECT_URI=http://127.0.0.1:36478

# Local development only: create/use a local Tasker user without the login screen.
TASKER_DEV_AUTH_BYPASS=false

# Desktop dual-lobe mode
TASKER_DUAL_LOBE_PROFILE=screen-aware
TASKER_SCREEN_HZ=4
TASKER_PREVIEW_TIMEOUT=120
TASKER_DUAL_LOBE_MAX_BATCHES=20

# Persona (DL-Companion) — unified mind Tasker attaches to. Mint a persona via
# DL-Companion: POST {SAWII_PERSONA_URL}/admin/personas with admin bearer; set the
# returned {id,key} here. Not a global key — the persona key itself.
SAWII_PERSONA_URL=https://dl-companion-production.up.railway.app
SAWII_PERSONA_KEY=

# Voice calls (Hands start_call lane).
# Provider: "simulated" (default; scripted tones + fake transcript, works fully
# offline) or "twilio" (media streams — REQUIRES the twilio SDK, the three creds
# below, and a public HTTPS webhook + WS media callback; see
# backend/utils/call_provider.py for the exact checklist).
TELEPHONY_PROVIDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
