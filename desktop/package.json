{
  "name": "tasker-desktop",
  "version": "0.1.2",
  "description": "Hands — Electron desktop application",
  "license": "ISC",
  "author": "Hands <hello@hands.app>",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:6763 && electron .\"",
    "react-start": "cd neuralagent-app && npm start",
    "react-build": "cd neuralagent-app && npm run build",
    "build:agent": "pyinstaller --clean --noconfirm --onefile --name agent --distpath agent_build/ aiagent/main.py",
    "build:suggestor": "pyinstaller --clean --noconfirm --onefile --name suggestor --distpath agent_build/ aiagent/suggestor.py",
    "build:agent:nuitko": "nuitka --standalone --onefile --lto=no --output-dir=agent_build/ --output-filename=agent --assume-yes-for-downloads --include-package=comtypes aiagent/main.py",
    "build:suggestor:nuitko": "nuitka --standalone --onefile --lto=no --output-dir=agent_build/ --output-filename=suggestor --assume-yes-for-downloads --include-package=comtypes aiagent/suggestor.py",
    "build": "npm run react-build && electron-builder",
    "dist": "npm run react-build && electron-builder",
    "dist:win": "npm run react-build && electron-builder --win --publish always",
    "dist:win:draft": "npm run react-build && electron-builder --win --publish never",
    "check:builder": "node scripts/verify-builder-config.mjs",
    "dev": "electron ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "express": "^5.1.0",
    "sudo-prompt": "^9.2.1",
    "tree-kill": "^1.2.2",
    "uuid": "^11.1.0"
  }
}
