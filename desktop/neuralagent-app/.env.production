# Baked into packaged (production) builds by CRA. Dev keeps 127.0.0.1 via the
# local (gitignored) .env. Wrong here = users see unreachable backend screens.
REACT_APP_PROTOCOL=https
REACT_APP_WEBSOCKET_PROTOCOL=wss
REACT_APP_DNS=dl-companion-production.up.railway.app
REACT_APP_API_KEY=
REACT_APP_DEV_AUTH_BYPASS=false
